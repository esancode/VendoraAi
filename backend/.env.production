NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]

REDIS_URL=redis://[REDIS_HOST]:[REDIS_PORT]
REDIS_HOST=[REDIS_PRODUCTION_HOST]
REDIS_PORT=6379
REDIS_PASSWORD=[REDIS_PRODUCTION_PASSWORD]

DATA_ENCRYPTION_KEY=[CHAVE_DE_32_BYTES_PARA_CRIPTOGRAFIA]

ASAAS_API_KEY=[API_KEY_ASAAS_SANDBOX_OU_PRODUCAO]
ASAAS_WEBHOOK_TOKEN=[TOKEN_DE_SEGURANCA_GERADO_NO_PAINEL_DO_ASAAS]

GEMINI_API_KEY=[GEMINI_API_KEY_GLOBAL_DA_PLATAFORMA]
OPENAI_API_KEY=[OPENAI_API_KEY_GLOBAL_DE_FALLBACK]
